        "gpt5": "gpt-5.2",
        "codex": "codex-5.3",
        "o3": "o3-mini"
      }
    },
    "google": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "env_key": "GOOGLE_API_KEY",
      "models": {
        "gemini_pro": "gemini-3-pro",
        "gemini_flash": "gemini-2.5-flash"
      }
    },
    "internal": {
      "base_url": "local",
      "env_key": null,
      "models": {
        "openclaw": "openclaw-engine",
        "ralph": "ralph-loop-v2"
      }
    }
  },
